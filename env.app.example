# These environment variables should be set in your application.
# Copy this file locally if needed, but do not commit runtime secrets.

# Platform Configuration (Production)

# ─── wa_api Connection ───────────────────────────────────────
# Points to the Rust Gateway
WA_API_URL=GATEWAY_URL

# Auth by the gateway is done using an environment variable named SUPABASE_JWT_SECRET.
# If you are not using Supabase, generate a JWT secret and configure both sides consistently.

# ─── Integration Settings ─────────────────────────────────────
WA_API_DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000000
WA_API_TIMEOUT_MS=15000
WA_API_RETRY_COUNT=2

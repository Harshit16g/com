# evo API deployment environment
# Use with:
#   docker compose -f docker-compose.evo.yml --env-file env.evo up -d

# -------------------------------------------------------------------
# Required by docker-compose.evo.yml
# -------------------------------------------------------------------
EVO_API_KEY=CHANGE_ME_IN_PRODUCTION
WA_API_WEBHOOK_URL=http://api-core:8080
POSTGRES_PASSWORD=wa_api_secret

# -------------------------------------------------------------------
# Optional compose/runtime overrides
# -------------------------------------------------------------------
EVO_PORT=8081
EVO_PUBLIC_URL=http://localhost:8081
DOCKER_REGISTRY=ghcr.io
IMAGE_NAME_PREFIX=harshit16g/leaex
IMAGE_TAG=latest

# -------------------------------------------------------------------
# Security note:
# wa_api requires x-webhook-secret on /webhook/evo.
# Ensure evo (or a proxy in front of evo) injects:
#   x-webhook-secret: <WEBHOOK_SHARED_SECRET from .env.wa_api>
# -------------------------------------------------------------------

# Leaex Platform Configuration (Production)

# ─── wa_api Connection ───────────────────────────────────────
# Points to the Rust Gateway
WA_API_URL=https://wa-api.up.railway.app
WA_API_BASE_URL=http://wa-api.up.railway.app

# ─── Auth Strategy ────────────────────────────────────────────
# [DEPRECATED] These static keys are legacy.
# The platform now uses Supabase JWT (Bearer Token) for all calls.
# The token is automatically verified by wa_api using SUPABASE_JWT_SECRET.
# WA_API_X_API_KEY=PAmplify1601!
# WA_API_ADMIN_KEY=AAmplify1601!
# X_ADMIN_KEY=AAmplify1601!
# X_API_KEY=PAmplify1601!

# ─── Integration Settings ─────────────────────────────────────
WA_API_DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000000
WA_API_TIMEOUT_MS=15000
WA_API_RETRY_COUNT=2

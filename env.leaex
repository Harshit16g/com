# Leaex platform integration environment for wa_api

# Base URL of wa_api API gateway
WA_API_BASE_URL=http://api-core:8080

# Partner API auth (must match PAUTH_API_KEY in .env.wa_api)
WA_API_X_API_KEY=CHANGE_ME_IN_PRODUCTION

# Default tenant/partner id for integration tests (UUID)
WA_API_DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000000

# Admin API auth (must match ADMIN_API_KEY in .env.wa_api)
WA_API_ADMIN_KEY=CHANGE_ME_IN_PRODUCTION

# Optional operation flags
WA_API_TIMEOUT_MS=15000
WA_API_RETRY_COUNT=2

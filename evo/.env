# ===========================================
# EVOLUTION API - ENVIRONMENT CONFIGURATION
# ===========================================

# SERVER
SERVER_NAME=evo
SERVER_TYPE=http
# ─── Server ──────────────────────────────────────────────────
SERVER_PORT=8080
SERVER_URL=http://evo_api:8080

SERVER_DISABLE_DOCS=false
SERVER_DISABLE_MANAGER=false

# CORS
CORS_ORIGIN=*
CORS_METHODS=POST,GET,PUT,DELETE
CORS_CREDENTIALS=true

# ─── Database (Docker network) ───────────────────────────────
DATABASE_PROVIDER=postgresql
DATABASE_CONNECTION_URI=postgresql://wa_api:wa_api_secret@postgres:5432/wa_api?schema=evo

DATABASE_CONNECTION_CLIENT_NAME=evo

DATABASE_SAVE_DATA_INSTANCE=true
DATABASE_SAVE_DATA_NEW_MESSAGE=true
DATABASE_SAVE_MESSAGE_UPDATE=true
DATABASE_SAVE_DATA_CONTACTS=true
DATABASE_SAVE_DATA_CHATS=true
DATABASE_SAVE_DATA_HISTORIC=true
DATABASE_SAVE_DATA_LABELS=true
DATABASE_SAVE_IS_ON_WHATSAPP=true
DATABASE_SAVE_IS_ON_WHATSAPP_DAYS=7
DATABASE_DELETE_MESSAGE=false

# REDIS (Local Docker Common)
CACHE_REDIS_ENABLED=true
CACHE_REDIS_URI=redis://redis:6379
CACHE_REDIS_PREFIX_KEY=evo-cache
CACHE_REDIS_TTL=3600
CACHE_REDIS_SAVE_INSTANCES=true

# Cache local fallback
CACHE_LOCAL_ENABLED=true
CACHE_LOCAL_TTL=86400

# AUTHENTICATION
AUTHENTICATION_API_KEY=leaex-evo-api-key-2026
AUTHENTICATION_EXPOSE_IN_FETCH_INSTANCES=false

# LOGS
LOG_LEVEL=ERROR,WARN,INFO,LOG
LOG_COLOR=true
LOG_BAILEYS=error

# WEBHOOK (wa_api gateway receives delivery events)
WEBHOOK_GLOBAL_URL=http://localhost:8080/webhook/evo
WEBHOOK_GLOBAL_ENABLED=true
WEBHOOK_GLOBAL_WEBHOOK_BY_EVENTS=false

WEBHOOK_EVENTS_APPLICATION_STARTUP=false
WEBHOOK_EVENTS_INSTANCE_CREATE=false
WEBHOOK_EVENTS_INSTANCE_DELETE=false
WEBHOOK_EVENTS_QRCODE_UPDATED=true
WEBHOOK_EVENTS_MESSAGES_SET=false
WEBHOOK_EVENTS_MESSAGES_UPSERT=true
WEBHOOK_EVENTS_MESSAGES_UPDATE=true
WEBHOOK_EVENTS_SEND_MESSAGE=false
WEBHOOK_EVENTS_CONTACTS_SET=false
WEBHOOK_EVENTS_CONTACTS_UPDATE=false
WEBHOOK_EVENTS_CONTACTS_UPSERT=false
WEBHOOK_EVENTS_PRESENCE_UPDATE=false
WEBHOOK_EVENTS_CHATS_SET=false
WEBHOOK_EVENTS_CHATS_UPDATE=false
WEBHOOK_EVENTS_CHATS_UPSERT=false
WEBHOOK_EVENTS_CONNECTION_UPDATE=true
WEBHOOK_EVENTS_CALL=false

# INSTANCE
DEL_INSTANCE=false
DEL_TEMP_INSTANCES=true

# QRCODE
QRCODE_LIMIT=30
QRCODE_COLOR=#198754

# SESSION / DEVICE NAME
CONFIG_SESSION_PHONE_CLIENT=LEAEX_CRM

# TELEMETRY
TELEMETRY=false
TELEMETRY_URL=

# ───────── Repo ─────────
Baileys

# ───────── Build Output ─────────
/dist
/node_modules

# ───────── Logs ─────────
logs/**.json
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# ───────── Docker Data ─────────
/docker-compose-data
/docker-data

# ───────── Package Locks (keep ONE, not all) ─────────
# ⚠️ Recommend keeping package-lock.json if using npm
/yarn.lock
/pnpm-lock.yaml

# ───────── IDE ─────────
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.nova/*
.idea/*

# ───────── Project Specific ─────────
/instances/*
!/instances/.gitkeep
/test/
/store
/temp/*

# ───────── System ─────────
.DS_Store
*.DS_Store
.tool-versions

# ───────── Prisma ─────────
/prisma/migrations/*

# ───────── ENV FILES (IMPORTANT CHANGE) ─────────
# Allow env files to be committed
!.env
!.env.*